                    <tbody id="tableBodyRekap"><tr><td colspan="9" class="text-center py-6">⏳ Memuat data...</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- KONTEN 2: MASTER PEGAWAI -->
    <div id="content-pegawai" class="max-w-7xl mx-auto px-4 hidden no-print">
