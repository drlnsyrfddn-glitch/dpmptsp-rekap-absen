            </form>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md mb-20 border">
            <div class="flex justify-between items-center mb-4 border-b pb-4">
                <h2 class="text-lg font-bold text-gray-700">Daftar Pegawai Saat Ini</h2>
                <input type="text" id="searchPegawai" oninput="renderTabelPegawai()" class="bg-gray-50 border border-gray-300 text-sm rounded block w-48 md:w-64 p-2" placeholder="Cari NIP / Nama...">
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left border-collapse border border-gray-300">
                    <thead class="bg-gray-100 uppercase text-xs font-bold">
                        <tr><th class="border px-4 py-2 w-10 text-center">No</th><th class="border px-4 py-2">NIP / NIK</th><th class="border px-4 py-2">Nama Lengkap</th><th class="border px-4 py-2">Jabatan</th><th class="border px-4 py-2 text-center">Kategori</th><th class="border px-4 py-2 text-center">Status</th><th class="border px-4 py-2 text-center">Aksi</th></tr>
                    </thead>
                    <tbody id="tableBodyPegawai"><tr><td colspan="7" class="text-center py-6">⏳ Memuat data...</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- KONTEN 3: MONITORING ABSEN DIGITAL (FITUR BARU) -->
    <div id="content-monitoring" class="max-w-7xl mx-auto px-4 hidden no-print animate-fade-in">
        <div class="mb-6 flex justify-between items-center bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Monitoring Absensi Digital</h2>
                <p class="text-gray-500 text-sm">Pemantauan lokasi dan waktu absen pegawai hari ini.</p>
            </div>
            <button onclick="loadLogHarian()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm flex items-center gap-2 shadow-md transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                Perbarui Data
            </button>
        </div>

        <!-- Statistik Cepat -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border-l-4 border-blue-600 flex items-center justify-between">
                <div><p class="text-gray-500 text-xs font-bold uppercase tracking-widest">Total Hadir</p><h3 id="stat-hadir" class="text-3xl font-black text-gray-800">0</h3></div>
                <div class="bg-blue-50 p-3 rounded-full text-blue-600"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border-l-4 border-amber-500 flex items-center justify-between">
                <div><p class="text-gray-500 text-xs font-bold uppercase tracking-widest">Terlambat</p><h3 id="stat-telat" class="text-3xl font-black text-gray-800">0</h3></div>
                <div class="bg-amber-50 p-3 rounded-full text-amber-500"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border-l-4 border-emerald-500 flex items-center justify-between">
                <div><p class="text-gray-500 text-xs font-bold uppercase tracking-widest">Tugas Luar</p><h3 id="stat-tl" class="text-3xl font-black text-gray-800">0</h3></div>
                <div class="bg-emerald-50 p-3 rounded-full text-emerald-500"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden mb-20">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-50 text-gray-600 text-[10px] uppercase font-black tracking-widest">
                        <tr>
                            <th class="px-6 py-4">Waktu Absen (WITA)</th>
                            <th class="px-6 py-4">Nama Pegawai</th>
                            <th class="px-6 py-4 text-center">Status</th>
                            <th class="px-6 py-4">Jarak GPS</th>
                            <th class="px-6 py-4 text-center">Lokasi Presisi</th>
                        </tr>
                    </thead>
                    <tbody id="tableBodyMonitoring" class="divide-y divide-gray-100 text-sm text-gray-700">
                        <tr><td colspan="5" class="text-center py-10 text-gray-400">⏳ Memuat log harian...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tanda Tangan Laporan -->
    <div class="hanya-print mt-10 pr-12 text-black">
        <table class="signature-table w-full text-black">
            <tr>
                <td style="width: 60%;"></td>
                <td style="width: 40%; text-align: left; font-size: 14px;">
                    <p class="mb-0" id="tanggalCetakLaporan">Bungku, ........................</p>
                    <p class="mb-20">Mengetahui,<br>Kepala Dinas Penanaman Modal dan PTSP<br>Kabupaten Morowali,</p>
                    <p class="font-bold underline mb-0">ELYTA GAWI, ST., MT</p>
                    <p>Pembina Utama Muda, IV/c <br>NIP. 19761212 200212 2 006</p>
                </td>
            </tr>
        </table>
    </div>

    <script>
        document.getElementById('namaUser').innerText = sessionStorage.getItem('userName');
        const URL_GAS = "https://script.google.com/macros/s/AKfycbxNNmH8GmlkJkBxzUkItWH1a5c1BbLWRAzy1fA4agwFiFJnCh8v1rgDfCNtbrzBUIfRAg/exec";
        
        let masterPegawai = [];
        let rawDataRekap = []; 
        let currentFilteredData = []; 

        function switchTab(tab) {
            document.getElementById('content-rekap').classList.add('hidden');
            document.getElementById('content-pegawai').classList.add('hidden');
            document.getElementById('content-monitoring').classList.add('hidden'); // Sembunyikan monitoring
            
            document.getElementById('tab-rekap').className = "px-4 py-2 font-bold rounded-md text-gray-500 hover:bg-gray-100 transition text-sm";
            document.getElementById('tab-pegawai').className = "px-4 py-2 font-bold rounded-md text-gray-500 hover:bg-gray-100 transition text-sm";
            document.getElementById('tab-monitoring').className = "px-4 py-2 font-bold rounded-md text-gray-500 hover:bg-gray-100 transition text-sm flex items-center gap-2";
            
            if (tab === 'rekap') {
                document.getElementById('content-rekap').classList.remove('hidden');
                document.getElementById('tab-rekap').className = "px-4 py-2 font-bold rounded-md bg-blue-100 text-blue-800 transition text-sm";
                document.getElementById('btnCetak').classList.remove('hidden');
                document.getElementById('btnExcel').classList.remove('hidden'); 
            } else if (tab === 'pegawai') {
                document.getElementById('content-pegawai').classList.remove('hidden');
                document.getElementById('tab-pegawai').className = "px-4 py-2 font-bold rounded-md bg-blue-100 text-blue-800 transition text-sm";
                document.getElementById('btnCetak').classList.add('hidden');
                document.getElementById('btnExcel').classList.add('hidden'); 
            } else if (tab === 'monitoring') {
                document.getElementById('content-monitoring').classList.remove('hidden');
                document.getElementById('tab-monitoring').className = "px-4 py-2 font-bold rounded-md bg-blue-100 text-blue-800 transition text-sm flex items-center gap-2";
                document.getElementById('btnCetak').classList.add('hidden');
                document.getElementById('btnExcel').classList.add('hidden');
                loadLogHarian(); // Auto load data saat tab dibuka
            }
        }

        window.onload = () => { 
            loadPegawai(() => { loadRekap(); }); 
        };

        // --- FUNGSI BARU: MONITORING DIGITAL ---
        function loadLogHarian() {
            const tbody = document.getElementById('tableBodyMonitoring');
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-10 text-blue-600 font-bold animate-pulse">Sedang sinkronisasi data dari satelit...</td></tr>';

            fetch(URL_GAS + "?action=get_log_harian")
            .then(res => res.json())
            .then(data => {
                tbody.innerHTML = '';
                if(data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-10 text-gray-400 italic">Belum ada data absen hari ini.</td></tr>';
                    return;
                }

                let hadir = 0, telat = 0, tl = 0;
                
                // Urutkan data terbaru di paling atas (reverse)
                data.reverse().forEach(log => {
                    // Hitung Stats
                    if(log.Aksi.includes("Datang")) hadir++;
                    if(log.Aksi.includes("Terlambat")) telat++;
                    if(log.Aksi === "Tugas Luar") tl++;

                    // Warna Badge Aksi
                    let badgeClass = "bg-blue-100 text-blue-700";
                    if(log.Aksi.includes("Terlambat")) badgeClass = "bg-amber-100 text-amber-700";
                    if(log.Aksi === "Pulang") badgeClass = "bg-gray-100 text-gray-700";
                    if(log.Aksi === "Tugas Luar") badgeClass = "bg-emerald-100 text-emerald-700";

                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-slate-50 transition border-b border-gray-50";
                    tr.innerHTML = `
                        <td class="px-6 py-4 font-mono text-xs text-gray-400 font-bold">${log.Waktu_Server}</td>
                        <td class="px-6 py-4">
                            <div class="font-bold text-gray-800">${log.Nama_Pegawai}</div>
                            <div class="text-[10px] text-gray-400 font-mono italic">${log.NIP_NIK}</div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="${badgeClass} px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-tighter">${log.Aksi}</span>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-1.5 ${log.Status_Jarak === 'Valid' ? 'text-emerald-600' : 'text-rose-500'}">
                                <div class="w-2 h-2 rounded-full bg-current"></div>
                                <span class="font-bold text-xs">${log.Status_Jarak}</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <a href="https://www.google.com/maps?q=${log.Koordinat_GPS}" target="_blank" class="bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold transition inline-flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"></path></svg>
                                Lacak Titik
                            </a>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

                // Update Stats Counter
                document.getElementById('stat-hadir').innerText = hadir;
                document.getElementById('stat-telat').innerText = telat;
                document.getElementById('stat-tl').innerText = tl;
            });
        }

        // --- FUNGSI REKAP & PEGAWAI (TETAP SAMA) ---
        async function cetakLaporan() {
            const bulanFilter = document.getElementById('filterBulan').value;
            if (!bulanFilter) { Swal.fire('Tunggu Dulu!', 'Silakan pilih bulan pada filter sebelum mencetak laporan.', 'warning'); return; }
            const today = new Date();
            const bulanIndo = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
            const tglDefault = `${today.getDate()} ${bulanIndo[today.getMonth()]} ${today.getFullYear()}`;
            const { value: tanggalInput } = await Swal.fire({
                title: 'Atur Tanggal Laporan', input: 'text', inputLabel: 'Masukkan tanggal untuk tanda tangan:', inputValue: tglDefault,
                showCancelButton: true, confirmButtonColor: '#10b981', cancelButtonColor: '#6b7280', confirmButtonText: 'Cetak Sekarang', cancelButtonText: 'Batal',
                inputValidator: (value) => { if (!value) { return 'Tanggal tidak boleh kosong!'; } }
            });
            if (tanggalInput) { document.getElementById('tanggalCetakLaporan').innerText = `Bungku, ${tanggalInput}`; setTimeout(() => { window.print(); }, 300); }
        }

        function autoFillNip() {
            const nipDipilih = document.getElementById('nipRekap').value;
            document.getElementById('nipPegawaiAuto').value = nipDipilih;
        }

        function loadRekap() {
            fetch(URL_GAS + "?action=get_rekap").then(res => res.json()).then(data => {
                rawDataRekap = data; 
                applyFilter(); 
            });
        }

        function applyFilter() {
            const bulanFilter = document.getElementById('filterBulan').value;
            const tahunFilter = document.getElementById('filterTahun').value;
            const textSearch = document.getElementById('searchRekap').value.toLowerCase(); 
            const tbody = document.getElementById('tableBodyRekap');
            const judulKop = document.getElementById('judulKopSurat');
            tbody.innerHTML = '';

            if (!bulanFilter) {
                judulKop.innerText = `LAPORAN REKAPITULASI ABSENSI PEGAWAI`;
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-12 text-gray-500 font-bold bg-blue-50 border-b border-blue-100 rounded-b-lg"><span class="text-3xl block mb-2">📅</span>Silakan pilih Bulan pada filter di atas terlebih dahulu untuk menampilkan data rekapitulasi.</td></tr>`;
                currentFilteredData = [];
                return;
            }

            if(bulanFilter === "Semua") { judulKop.innerText = `LAPORAN REKAPITULASI ABSENSI PEGAWAI TAHUN ${tahunFilter}`; } 
            else { judulKop.innerText = `LAPORAN REKAPITULASI ABSENSI PEGAWAI BULAN ${bulanFilter.toUpperCase()} ${tahunFilter}`; }

            let filteredData = rawDataRekap.filter(row => row.ID_Rekap); 
            if (bulanFilter !== "Semua") filteredData = filteredData.filter(row => row.Bulan === bulanFilter);
            if (tahunFilter) filteredData = filteredData.filter(row => row.Tahun == tahunFilter);
            if (textSearch) {
                filteredData = filteredData.filter(row => {
                    const peg = masterPegawai.find(p => p.NIP_NIK === row.NIP_NIK);
                    const nama = peg ? peg.Nama_Lengkap.toLowerCase() : "";
                    const nip = row.NIP_NIK ? row.NIP_NIK.toLowerCase() : "";
                    return nama.includes(textSearch) || nip.includes(textSearch);
                });
            }

            currentFilteredData = filteredData; 
            if(filteredData.length === 0) { tbody.innerHTML = `<tr><td colspan="9" class="text-center py-6 text-gray-500">Tidak ada data absen untuk bulan ${bulanFilter}.</td></tr>`; return; }
            
            filteredData.forEach(row => {
                const peg = masterPegawai.find(p => p.NIP_NIK === row.NIP_NIK);
                const namaTampil = peg ? peg.Nama_Lengkap : "<span class='text-red-500 italic'>Pegawai Terhapus</span>";
                tbody.innerHTML += `<tr class="hover:bg-gray-50 transition">
                    <td class="border px-4 py-2"><div class="font-bold text-blue-800">${namaTampil}</div><div class="text-xs text-gray-500 font-mono mt-0.5">${row.NIP_NIK}</div></td>
                    <td class="border px-4 py-2 text-center">${row.Bulan}</td><td class="border px-4 py-2 text-center">${row.Tahun}</td>
                    <td class="border px-4 py-2 text-center text-green-600 font-bold">${row.Hadir}</td><td class="border px-4 py-2 text-center">${row.Sakit}</td>
                    <td class="border px-4 py-2 text-center">${row.Izin}</td><td class="border px-4 py-2 text-center text-red-600">${row.Alpa}</td><td class="border px-4 py-2 text-xs">${row.Keterangan}</td>
                    <td class="border px-4 py-2 text-center no-print whitespace-nowrap"><button onclick="editRekap('${row.NIP_NIK}', '${row.Bulan}', '${row.Tahun}', '${row.Hadir}', '${row.Sakit}', '${row.Izin}', '${row.Alpa}', '${row.Keterangan}')" class="text-blue-500 hover:text-blue-700 mr-2 font-bold">✎ Edit</button><button onclick="hapusRekap('${row.ID_Rekap}')" class="text-red-500 hover:text-red-700 font-bold">🗑 Hapus</button></td>
                </tr>`;
            });
        }

        function exportKeExcel() {
            if(currentFilteredData.length === 0) { Swal.fire('Tabel Kosong', 'Silakan pilih bulan pada filter terlebih dahulu.', 'warning'); return; }
            const dataExcel = currentFilteredData.map((row, index) => {
                const peg = masterPegawai.find(p => p.NIP_NIK === row.NIP_NIK);
                return { "No": index + 1, "Nama Pegawai": peg ? peg.Nama_Lengkap : "Pegawai Terhapus", "NIP / NIK": row.NIP_NIK, "Jabatan": peg ? peg.Jabatan : "-", "Status": peg ? peg.Kategori : "-", "Bulan": row.Bulan, "Tahun": row.Tahun, "Hadir": parseInt(row.Hadir) || 0, "Sakit": parseInt(row.Sakit) || 0, "Izin": parseInt(row.Izin) || 0, "Alpa": parseInt(row.Alpa) || 0, "Keterangan": row.Keterangan || "-" };
            });
            const ws = XLSX.utils.json_to_sheet(dataExcel); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Data Absen");
            const namaFile = `Rekap_Absen_DPMPTSP_${document.getElementById('filterBulan').value}_${document.getElementById('filterTahun').value}.xlsx`;
            XLSX.writeFile(wb, namaFile);
            Swal.fire({ title: 'Berhasil!', text: 'File Excel sedang diunduh.', icon: 'success', timer: 1500, showConfirmButton: false });
        }

        document.getElementById('formAbsen').addEventListener('submit', function(e) {
            e.preventDefault();
            const h = parseInt(document.getElementById('hadir').value) || 0; const s = parseInt(document.getElementById('sakit').value) || 0;
            const i = parseInt(document.getElementById('izin').value) || 0; const a = parseInt(document.getElementById('alpa').value) || 0;
            if(h+s+i+a > 31) { Swal.fire('Peringatan Logika', 'Total input absensi melebihi jumlah hari dalam sebulan (31 hari)!', 'warning'); return; }
            const btn = document.getElementById('btnSubmitRekap'); btn.innerText = "Menyimpan..."; btn.disabled = true; 
            const payload = { action: "simpan_absen", nip: document.getElementById('nipRekap').value, bulan: document.getElementById('bulanRekap').value, tahun: document.getElementById('tahunRekap').value, hadir: h, sakit: s, izin: i, alpa: a, keterangan: document.getElementById('keteranganRekap').value };
            fetch(URL_GAS, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) })
            .then(res => res.json()).then(data => { Swal.fire({ title: 'Berhasil!', text: 'Data absen berhasil disimpan ke server.', icon: 'success', timer: 2000, showConfirmButton: false }); loadRekap(); resetFormRekap(); });
        });

        function editRekap(nip, bulan, tahun, hadir, sakit, izin, alpa, ket) {
            document.getElementById('formTitleRekap').innerText = "✎ Edit Data Absensi"; document.getElementById('formTitleRekap').classList.add('text-amber-600');
            document.getElementById('btnSubmitRekap').innerText = "Update Data"; document.getElementById('btnBatalRekap').classList.remove('hidden');
            document.getElementById('nipRekap').value = nip; autoFillNip(); document.getElementById('bulanRekap').value = bulan; document.getElementById('tahunRekap').value = tahun;
            document.getElementById('hadir').value = hadir; document.getElementById('sakit').value = sakit; document.getElementById('izin').value = izin; document.getElementById('alpa').value = alpa;
            document.getElementById('keteranganRekap').value = ket; window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function hapusRekap(idRekap) {
            Swal.fire({ title: 'Hapus Rekap Absen?', text: "Data ini akan dihapus secara permanen dari database!", icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', cancelButtonColor: '#3085d6', confirmButtonText: 'Ya, Hapus!' })
            .then((result) => { if (result.isConfirmed) { fetch(URL_GAS, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify({ action: "hapus_absen", idRekap: idRekap }) }).then(res => res.json()).then(() => { Swal.fire('Terhapus!', 'Data absen telah dihapus.', 'success'); loadRekap(); }); } });
        }

        function resetFormRekap() {
            document.getElementById('formAbsen').reset(); document.getElementById('nipPegawaiAuto').value = "";
            document.getElementById('formTitleRekap').innerText = "Input Rekap Absensi Baru"; document.getElementById('formTitleRekap').classList.remove('text-amber-600');
            document.getElementById('btnSubmitRekap').innerText = "Simpan Data Absen"; document.getElementById('btnSubmitRekap').disabled = false;
            document.getElementById('btnBatalRekap').classList.add('hidden');
        }

        function loadPegawai(callback = null) {
            fetch(URL_GAS + "?action=get_pegawai").then(res => res.json()).then(data => {
                masterPegawai = data;
                const selectNip = document.getElementById('nipRekap'); selectNip.innerHTML = '<option value="">-- Pilih Pegawai --</option>';
                data.forEach(p => { if(p.NIP_NIK) selectNip.innerHTML += `<option value="${p.NIP_NIK}">${p.Nama_Lengkap} (${p.NIP_NIK})</option>`; });
                renderTabelPegawai(); if(callback) callback();
            });
        }

        function renderTabelPegawai() {
            const tbody = document.getElementById('tableBodyPegawai');
            const textSearch = document.getElementById('searchPegawai').value.toLowerCase();
            tbody.innerHTML = '';
            let dataTampil = masterPegawai.filter(row => row.NIP_NIK); 
            if(textSearch) { dataTampil = dataTampil.filter(row => row.Nama_Lengkap.toLowerCase().includes(textSearch) || row.NIP_NIK.toLowerCase().includes(textSearch)); }
            if(dataTampil.length === 0) { tbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-gray-500">Tidak ada pegawai ditemukan.</td></tr>'; return; }
            dataTampil.forEach((row, index) => {
                let badge = row.Status === "Aktif" ? `<span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold">Aktif</span>` : `<span class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-bold">Tidak Aktif</span>`;
                tbody.innerHTML += `<tr class="hover:bg-gray-50 transition"><td class="border px-4 py-2 text-center">${index + 1}</td><td class="border px-4 py-2 font-mono text-gray-600">${row.NIP_NIK}</td><td class="border px-4 py-2 text-blue-800 font-bold">${row.Nama_Lengkap}</td><td class="border px-4 py-2">${row.Jabatan}</td><td class="border px-4 py-2 text-center">${row.Kategori}</td><td class="border px-4 py-2 text-center">${badge}</td><td class="border px-4 py-2 text-center whitespace-nowrap"><button onclick="editPegawai('${row.NIP_NIK}', '${row.Nama_Lengkap}', '${row.Jabatan}', '${row.Kategori}', '${row.Status}')" class="text-blue-500 hover:text-blue-700 mr-2 font-bold">✎ Edit</button><button onclick="hapusPegawai('${row.NIP_NIK}')" class="text-red-500 hover:text-red-700 font-bold">🗑 Hapus</button></td></tr>`;
            });
        }

        document.getElementById('formPegawai').addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitPegawai'); btn.innerText = "Menyimpan..."; btn.disabled = true; 
            const payload = { action: "simpan_pegawai", nip: document.getElementById('nipMaster').value, nama: document.getElementById('namaMaster').value, jabatan: document.getElementById('jabatanMaster').value, kategori: document.getElementById('kategoriMaster').value, status: document.getElementById('statusMaster').value };
            fetch(URL_GAS, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) })
            .then(res => res.json()).then(data => { Swal.fire({ title: 'Tersimpan!', text: data.message, icon: 'success', timer: 2000, showConfirmButton: false }); loadPegawai(() => { loadRekap(); resetFormPegawai(); }); });
        });

        function editPegawai(nip, nama, jabatan, kategori, status) {
            document.getElementById('formTitlePegawai').innerText = "✎ Edit Data Pegawai"; document.getElementById('formTitlePegawai').classList.add('text-amber-600');
            document.getElementById('btnSubmitPegawai').innerText = "Update Data"; document.getElementById('btnBatalPegawai').classList.remove('hidden');
            document.getElementById('nipMaster').value = nip; document.getElementById('nipMaster').readOnly = true; document.getElementById('nipMaster').classList.add('bg-gray-100');
            document.getElementById('namaMaster').value = nama; document.getElementById('jabatanMaster').value = jabatan; document.getElementById('kategoriMaster').value = kategori; document.getElementById('statusMaster').value = status;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function hapusPegawai(nip) {
            Swal.fire({ title: 'Hapus Pegawai?', text: `Yakin ingin menghapus NIP ${nip}? Ini akan menyembunyikan namanya dari form absen.`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', cancelButtonColor: '#3085d6', confirmButtonText: 'Ya, Hapus!' })
            .then((result) => { if (result.isConfirmed) { fetch(URL_GAS, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify({ action: "hapus_pegawai", nip: nip }) }).then(res => res.json()).then(() => { Swal.fire('Terhapus!', 'Pegawai telah dihapus dari sistem.', 'success'); loadPegawai(() => { loadRekap(); }); }); } });
        }

        function resetFormPegawai() {
            document.getElementById('formPegawai').reset(); document.getElementById('nipMaster').readOnly = false; document.getElementById('nipMaster').classList.remove('bg-gray-100');
            document.getElementById('formTitlePegawai').innerText = "Form Tambah Pegawai Baru"; document.getElementById('formTitlePegawai').classList.remove('text-amber-600');
            document.getElementById('btnSubmitPegawai').innerText = "Simpan Data Pegawai"; document.getElementById('btnSubmitPegawai').disabled = false;
            document.getElementById('btnBatalPegawai').classList.add('hidden');
        }
    </script>
</body>
</html>