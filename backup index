            </div>
            <div class="overflow-x-auto">
                <table class="data-table w-full text-sm text-left border-collapse border border-gray-300">
                    <thead class="bg-gray-100 uppercase text-xs font-bold">
                        <tr>
                            <th class="border px-4 py-2">Nama Pegawai / NIP</th>
                            <th class="border px-4 py-2 text-center">Bulan</th><th class="border px-4 py-2 text-center">Tahun</th>
